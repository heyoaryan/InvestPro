generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum PackageTier {
  STARTER
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PackageStatus {
  ACTIVE
  CAPPED
  PENDING
  REJECTED
}

enum TransactionType {
  ROI
  DIRECT_REFERRAL
  TEAM_COMMISSION
  WITHDRAWAL
  DEPOSIT
  ADMIN_ADJUSTMENT
}

enum TransactionStatus {
  COMPLETED
  PENDING
  FAILED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  referralCode String   @unique
  referredById String?
  role         Role     @default(MEMBER)
  walletBalance Float   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  packages     Package[]
  transactions Transaction[]
  withdrawals  Withdrawal[]

  commissionsReceived Commission[] @relation("CommissionReceiver")
  commissionsGiven    Commission[] @relation("CommissionGiver")

  @@index([referredById])
  @@index([referralCode])
}

model Package {
  id               String        @id @default(cuid())
  userId           String
  tier             PackageTier
  investmentAmount Float
  dailyRoiRate     Float
  startDate        DateTime      @default(now())
  totalEarned      Float         @default(0)
  maxEarnings      Float
  status           PackageStatus @default(ACTIVE)
  capped           Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  commissions Commission[]

  @@index([userId])
  @@index([status])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  status      TransactionStatus @default(COMPLETED)
  description String
  createdAt   DateTime          @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Commission {
  id              String   @id @default(cuid())
  fromUserId      String
  toUserId        String
  packageId       String
  level           Int
  totalAmount     Float
  installment1    Float
  installment2    Float
  installment3    Float
  inst1Paid       Boolean  @default(false)
  inst2Paid       Boolean  @default(false)
  inst3Paid       Boolean  @default(false)
  inst1PaidAt     DateTime?
  inst2PaidAt     DateTime?
  inst3PaidAt     DateTime?
  activationDate  DateTime @default(now())
  flushedAmount   Float    @default(0)
  createdAt       DateTime @default(now())

  fromUser User    @relation("CommissionGiver", fields: [fromUserId], references: [id])
  toUser   User    @relation("CommissionReceiver", fields: [toUserId], references: [id])
  package  Package @relation(fields: [packageId], references: [id])

  @@index([toUserId])
  @@index([fromUserId])
  @@index([activationDate])
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  amount      Float
  fee         Float
  netAmount   Float
  status      WithdrawalStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  processedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model AdminReserve {
  id               String   @id @default(cuid())
  amount           Float
  reason           String
  fromCommissionId String?
  createdAt        DateTime @default(now())
}
