# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Use the "Transaction" pooler URL for DATABASE_URL (port 6543) on Supabase
# so Prisma works correctly under Vercel's serverless connection limits.
# Use the direct connection URL for DIRECT_URL (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32-output"
# Set to your production URL — no trailing slash
NEXTAUTH_URL="https://your-app.vercel.app"

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Vercel sends this as "Authorization: Bearer <secret>" to /api/cron/daily-roi
CRON_SECRET="replace-with-openssl-rand-hex-32-output"

# ─── Admin seed account ───────────────────────────────────────────────────────
# Used only by prisma/seed.ts — change before seeding production
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="use-a-very-strong-password"

# ─── Admin setup code ─────────────────────────────────────────────────────────
# Required only when the very first account is created via /register.
# Enter this code in the admin modal to claim the ADMIN role.
# Keep this secret — never expose in frontend or logs.
ADMIN_SETUP_CODE="replace-with-your-own-secret-code"
